{
  "name": "personal-workbench",
  "private": true,
  "version": "0.0.1-dev.1",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite --config config/vite.config.ts",
    "build": "npm run build:archify && tsc -b && vite build --config config/vite.config.ts",
    "build:archify": "node scripts/build-archify-runtime.mjs",
    "check:architecture": "node scripts/check-pwcli-architecture.mjs",
    "test": "vitest run --config config/vitest.config.ts",
    "test:coverage": "vitest run --coverage --config config/vitest.config.ts",
    "lint": "eslint . --config config/eslint.config.js",
    "preview": "vite preview --config config/vite.config.ts"
  },
  "postcss": {
    "plugins": {
      "tailwindcss": {
        "config": "./config/tailwind.config.js"
      },
      "autoprefixer": {}
    }
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "diff": "^8.0.4",
    "dompurify": "^3.4.12",
    "framer-motion": "^12.38.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.17.0",
    "lucide-react": "^0.364.0",
    "mermaid": "^11.15.0",
    "monaco-editor": "^0.53.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sortablejs": "^1.15.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^25.4.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "jsdom": "^29.0.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.0.1",
    "vitest": "^4.1.4"
  }
}
